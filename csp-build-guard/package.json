{
  "name": "@fedemedinilla/csp-build-guard",
  "version": "0.1.0",
  "description": "Audits a built static site before deploy: inline script hashes against the Content-Security-Policy, the exact policy per page, secrets in the bundle, regex lookbehind and a JavaScript budget. A CLI with SARIF output, a GitHub Action and a library.",
  "license": "MIT",
  "author": "Federico Medinilla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fedemedinilla/applied-ai-toolkit.git",
    "directory": "csp-build-guard"
  },
  "homepage": "https://github.com/Fedemedinilla/applied-ai-toolkit/tree/main/csp-build-guard#readme",
  "bugs": {
    "url": "https://github.com/Fedemedinilla/applied-ai-toolkit/issues"
  },
  "keywords": [
    "csp",
    "content-security-policy",
    "static-site",
    "build",
    "security",
    "sarif",
    "vercel",
    "netlify"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/src/run.d.ts",
      "default": "./dist/src/run.js"
    },
    "./config": {
      "types": "./dist/src/config.d.ts",
      "default": "./dist/src/config.js"
    },
    "./report": {
      "types": "./dist/src/report.d.ts",
      "default": "./dist/src/report.js"
    },
    "./sarif": {
      "types": "./dist/src/sarif.d.ts",
      "default": "./dist/src/sarif.js"
    },
    "./site": {
      "types": "./dist/src/site.d.ts",
      "default": "./dist/src/site.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/src/run.d.ts",
  "bin": {
    "csp-build-guard": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "node -e \"require('node:fs').copyFileSync('../LICENSE','LICENSE')\" && npm run build"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
