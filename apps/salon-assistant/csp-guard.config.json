{
  "csp": {
    "from": "literal",
    "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
  },
  "policy": {
    "default-src": ["'self'"],
    "script-src": ["'self'"],
    "style-src": ["'self'"],
    "img-src": ["'self'"],
    "connect-src": ["'self'"],
    "object-src": ["'none'"],
    "base-uri": ["'self'"],
    "form-action": ["'self'"]
  },
  "secrets": {
    "env": ["ANTHROPIC_API_KEY", "ASSISTANT_HISTORY_SECRET"],
    "missing": "skip"
  },
  "lookbehind": {
    "targets": {
      "safari": "15.6",
      "ios": "15.6",
      "chrome": 109
    }
  },
  "budgets": [
    {
      "pages": "index.html",
      "gzipKb": 10,
      "brotliKb": 10
    }
  ]
}
