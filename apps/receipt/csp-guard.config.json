{
  "csp": {
    "from": "literal",
    "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-src blob:; object-src 'none'; base-uri 'self'"
  },
  "policy": {
    "default-src": ["'self'"],
    "script-src": ["'self'"],
    "style-src": ["'self'"],
    "img-src": ["'self'", "data:"],
    "connect-src": ["'self'"],
    "frame-src": ["blob:"],
    "object-src": ["'none'"],
    "base-uri": ["'self'"]
  },
  "lookbehind": {
    "targets": {
      "safari": "15.6",
      "ios": "15.6",
      "chrome": 109
    }
  },
  "budgets": [
    {
      "pages": "index.html",
      "gzipKb": 200,
      "brotliKb": 190
    }
  ]
}
