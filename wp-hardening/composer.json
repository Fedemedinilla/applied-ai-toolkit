{
    "name": "fmedinilla/wp-hardening",
    "description": "WordPress plugin that applies the hardening controls that can be set in code, with Site Health tests and a WP-CLI command.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "brain/monkey": "2.7.0",
        "mockery/mockery": "1.6.15",
        "phpunit/phpunit": "10.5.66"
    },
    "autoload": {
        "psr-4": {
            "WpHardening\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WpHardening\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
