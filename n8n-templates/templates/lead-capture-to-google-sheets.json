            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Discard (no valid email)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize fields": {
      "main": [
        [
          {
            "node": "Save to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
