{
  "name": "applied-ai-toolkit",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit",
    "test:python": "cd site-check && python3 -m unittest discover -s tests -q",
    "lint:docs": "node slop-lint/cli.ts --lang en --format markdown README.md */README.md apps/*/README.md evals/CASE-STUDY.md",
    "build:caja": "vite build apps/caja",
    "build:apps": "npm run build:caja",
    "guard:apps": "node csp-build-guard/cli.ts --dir dist/apps/caja --config apps/caja/csp-guard.config.json"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "24.19.2",
    "@types/web-push": "3.6.4",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "pdf-lib": "1.17.1",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  }
}
