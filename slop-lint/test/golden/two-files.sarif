{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "slop-lint",
          "informationUri": "https://github.com/Fedemedinilla/applied-ai-toolkit/tree/main/slop-lint",
          "rules": [
            {
              "id": "LEX-03",
              "shortDescription": {
                "text": "Tier 1 phrases (English)"
              },
              "fullDescription": {
                "text": "Banned cover-letter phrase."
              },
              "help": {
                "text": "Replace it with a fact from the CV: a project, a tool, a number, a year."
              },
              "helpUri": "https://arxiv.org/pdf/2406.07016",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "level": 1,
                "severity": "high",
                "evidence": [
                  "MEDIDO",
                  "CONSENSO"
                ],
                "source": "Kobak et al. 2025, Science Advances (arxiv.org/pdf/2406.07016); section 12, English Tier 1"
              }
            },
            {
              "id": "LEX-04",
              "shortDescription": {
                "text": "Tier 2 vocabulary (English)"
              },
              "fullDescription": {
                "text": "Excess style vocabulary. Tolerated twice per text, never the same word twice."
              },
              "help": {
                "text": "Use the plain verb or the fact."
              },
              "helpUri": "https://arxiv.org/html/2403.07183v2",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "level": 2,
                "severity": "medium",
                "evidence": [
                  "MEDIDO"
                ],
                "source": "Liang et al. 2024, ICML (arxiv.org/html/2403.07183v2); Kobak et al. 2025"
              }
            },
            {
              "id": "EST-08",
              "shortDescription": {
                "text": "Participle tail"
              },
              "fullDescription": {
                "text": "Gerund or participle tail that tacks a consequence onto the sentence."
              },
              "help": {
                "text": "Give the result its own clause: \"; so the close went from 3 days to 4 hours\"."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "level": 2,
                "severity": "medium",
                "evidence": [
                  "NORMA",
                  "SÍNTESIS"
                ],
                "source": "NGLE (RAE/ASALE) on the gerund of posteriority; section 5.1"
              }
            },
            {
              "id": "FMT-02",
              "shortDescription": {
                "text": "Emoji"
              },
              "fullDescription": {
                "text": "Emoji in a cover letter."
              },
              "help": {
                "text": "Delete it."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "level": 1,
                "severity": "high",
                "evidence": [
                  "CONSENSO"
                ],
                "source": "Section 4.4"
              }
            }
          ]
        }
      },
      "columnKind": "unicodeCodePoints",
