{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.config.ts", "dir": "amount-parser" },
  "mutate": ["amount-parser/src/money.ts", "amount-parser/src/numbers.ts", "amount-parser/src/tokens.ts"],
  "coverageAnalysis": "perTest",
  "ignorePatterns": ["/apps", "/dist", "/reports", "/site-check", "/wp-hardening", "/n8n-templates", "/coverage"],
  "tempDirName": ".stryker-tmp",
  "reporters": ["clear-text", "json", "html"],
  "jsonReporter": { "fileName": "reports/mutation/amount-parser/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation/amount-parser/mutation.html" },
  "thresholds": { "high": 95, "low": 85, "break": 70 }
}
