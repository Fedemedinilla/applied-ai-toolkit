{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.config.ts", "dir": "grounded-assistant" },
  "mutate": ["grounded-assistant/src/decide.ts", "grounded-assistant/src/money-guard.ts"],
  "coverageAnalysis": "perTest",
  "ignorePatterns": ["/apps", "/dist", "/reports", "/site-check", "/wp-hardening", "/n8n-templates", "/coverage"],
  "tempDirName": ".stryker-tmp",
  "reporters": ["clear-text", "json", "html"],
  "jsonReporter": { "fileName": "reports/mutation/grounded-assistant/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation/grounded-assistant/mutation.html" },
  "thresholds": { "high": 95, "low": 85, "break": 76 }
}
